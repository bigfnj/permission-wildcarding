#!/usr/bin/env node
'use strict';

const fs = require('fs');
const path = require('path');
const os  = require('os');
// NOTE: `../src/permissions` is NOT required here. Every name this file used to
// destructure from it -- writeFileAtomicSync, applyBypass, isBypassOn,
// currentMode, applyMax, isMaxOn, maxLayers -- is used only inside bypass(),
// codexMax() and max(), which are command verbs. Nothing on the hook path needs
// it once the fixed-point cache answers the common case, and the require is
// 3.5 ms of the ~13 ms that cache saves. A test asserts the module is absent
// from require.cache on a hit, because moving this back would halve the win with
// no functional symptom at all.
// codex-max, agent-guidance, agent-gates and child_process are used by exactly
// one command verb each and by nothing on the hook path, which runs after every
// single tool call. `learn()` below already lazy-requires the learner stack for
// this reason; the same reasoning was never extended to these. Measured at the
// process level: 50 ms for bare node, 58 ms with only what the hook needs,
// 70 ms with all of it, so this is ~12 ms returned per tool call.
//
// `policy-lock` and `local-settings` were the two the reasoning missed, and they
// were the ones it applied to most cleanly: BOTH are reachable only after the
// existsSync gate in finish(), the case the comment there documents as
// normal ("zero such files exist anywhere in the measured project tree"), and
// each drags a further module in — crypto behind policy-lock, policy-guard
// behind local-settings. Re-measured over 15 runs each: 50.1 ms bare node,
// 63.3 ms with permissions alone, 71.6 ms with all three. Another ~8 ms
// returned per tool call, for requires the common path never reaches. Node
// caches modules, so the verbs that do need them pay the load exactly once.

const SETTINGS  = path.join(os.homedir(), '.claude', 'settings.json');
const PACK_PATH = path.join(__dirname, '..', 'patterns', 'starter-pack.json');
const LEARN_USAGE = 'usage: wildcard-perms --learn scan|status|apply|undo|hits ' +
  '[--mode observe|recommend|auto-safe] [--workspace <path>] ' +
  '[--codex-scope user|workspace|off] [--threshold <count>] ' +
  '[--codex-executable <path>]\n';
const DRAIN_USAGE = 'usage: wildcard-perms --drain [--workspace <path>] [--dry-run]\n';
const GUIDANCE_USAGE = 'usage: wildcard-perms --guidance on|off|status\n' +
  '       wildcard-perms --guidance derived\n' +
  '       wildcard-perms --guidance accept|decline|reset <id>\n';
const GATES_USAGE = 'usage: wildcard-perms --gates on|off|status|refresh\n';

// Every verb, so an unrecognized flag can be told apart from hook mode below.
const VERBS = ['--learn', '--seed', '--drain', '--guidance', '--gates',
  '--codex-max', '--max', '--bypass'];
const HELP_USAGE = 'wildcard-perms — generalize approved Claude Code and Codex permissions\n\n' +
  'Run with NO arguments to act as a PostToolUse hook (reads a JSON event on stdin).\n\n' +
  LEARN_USAGE + DRAIN_USAGE + GUIDANCE_USAGE + GATES_USAGE +
  'usage: wildcard-perms --seed\n' +
  'usage: wildcard-perms --max on|off|status\n' +
  'usage: wildcard-perms --codex-max on|off|status\n' +
  'usage: wildcard-perms --bypass on|off|status\n' +
  'usage: wildcard-perms --help | --version\n';

const argv = process.argv.slice(2);
if (argv.includes('--help') || argv.includes('-h')) {
  // Before the verbs on purpose, so `--learn --help` explains rather than runs.
  process.stdout.write(HELP_USAGE);
} else if (argv.includes('--version') || argv.includes('-V')) {
  // Required lazily: the hook path must not pay for reading package.json.
  process.stdout.write(`${require('../package.json').version}\n`);
} else if (argv.length && !VERBS.some((verb) => argv.includes(verb))
    && argv.some((arg) => arg.startsWith('-'))) {
  // An unrecognized flag must NEVER reach hook mode. Hook mode rewrites
  // settings.json, so `--gate` (a typo for `--gates`) silently rewrote the
  // user's permission policy and exited 0 — and on a TTY, where nothing ever
  // closes stdin, it instead hung forever waiting for an event that was never
  // coming. There was also no `--help` at all, so the single most likely first
  // command anyone types was itself a policy write.
  process.stderr.write('wildcard-perms: unrecognized option '
    + `${argv.filter((arg) => arg.startsWith('-')).join(' ')}\n\n${HELP_USAGE}`);
  process.exitCode = 2;
} else if (argv.includes('--learn')) {
  learn(argv);
} else if (argv.includes('--seed')) {
  seed();
} else if (argv.includes('--drain')) {
  drain(argv);
} else if (argv.includes('--guidance')) {
  guidance(argv);
} else if (argv.includes('--gates')) {
  gates(argv);
} else if (argv.includes('--codex-max')) {
  codexMax(argv);
} else if (argv.includes('--max')) {
  max(argv);
} else if (argv.includes('--bypass')) {
  bypass(argv);
} else {
  // Hook mode. Claude Code sends a JSON context on stdin, and one field of it
  // matters: `cwd` names the project whose settings.local.json may have just
  // received the approval that fired this hook.
  let input = '';
  process.stdin.setEncoding('utf8');
  process.stdin.on('data', (chunk) => { input += chunk; });
  process.stdin.on('end', () => run(input));
  process.stdin.resume();
}

// The first positional argument after a verb, with flag/value pairs skipped, so
// a flag written before the id is not mistaken for the id.
function positionalAfter(args, name, skip) {
  const start = args.indexOf(name);
  if (start === -1) return undefined;
  for (let index = start + skip; index < args.length; index += 1) {
    if (String(args[index]).startsWith('--')) { index += 1; continue; }
    return args[index];
  }
  return undefined;
}

function learnOption(args, name, fallback) {
  const index = args.indexOf(name);
  if (index === -1) return fallback;
  const value = args[index + 1];
  if (!value || value.startsWith('--')) throw new Error(`${name} requires a value`);
  return value;
}

function learn(args) {
  // Keep the PostToolUse hot path independent of the optional learner stack.
  const { createAutoLearnManager } = require('../src/auto-learn-manager');
  const index = args.indexOf('--learn');
  const action = String(args[index + 1] || 'status').toLowerCase();

  try {
    const modeValue = learnOption(args, '--mode', null);
    const mode = modeValue ? String(modeValue).toLowerCase() : null;
    if (mode && !['observe', 'recommend', 'auto-safe'].includes(mode)) {
      process.stderr.write(LEARN_USAGE);
      process.exitCode = 1;
      return;
    }
    const workspaceRoot = path.resolve(learnOption(args, '--workspace', process.cwd()));
    const codexScope = String(learnOption(args, '--codex-scope', 'user')).toLowerCase();
    if (!['user', 'workspace', 'off'].includes(codexScope)) {
      process.stderr.write(LEARN_USAGE);
      process.exitCode = 1;
      return;
    }
    const thresholdValue = learnOption(args, '--threshold', null);
    const threshold = thresholdValue === null ? null : Number(thresholdValue);
    if (threshold !== null && (!Number.isInteger(threshold) || threshold < 1)) {
      throw new Error('--threshold must be a positive integer');
    }
    const codexRulesPath = codexScope === 'off' ? null
      : codexScope === 'workspace'
        ? path.join(workspaceRoot, '.codex', 'rules', 'permission-wildcarding.rules')
        : path.join(os.homedir(), '.codex', 'rules', 'permission-wildcarding.rules');
    const manager = createAutoLearnManager({
      workspaceRoot,
      codexRulesPath,
      codexExecutable: learnOption(args, '--codex-executable', 'codex'),
      mode: mode || 'recommend',
      threshold: threshold || 3,
    });
    if (mode || threshold !== null) {
      const current = manager.status();
      manager.setMode(mode || current.mode, threshold === null ? undefined : threshold);
    }

    let result;
    if (action === 'scan') result = manager.scan();
    else if (action === 'status') result = manager.status();
    else if (action === 'apply') result = manager.apply({ includeReviewed: false });
    else if (action === 'undo') result = manager.undo();
    else if (action === 'hits') result = manager.rebuildManagedHits();
    else {
      process.stderr.write(LEARN_USAGE);
      process.exitCode = 1;
      return;
    }
    process.stdout.write(JSON.stringify(result, null, 2) + '\n');
  } catch (error) {
    process.stderr.write(`wildcard-perms --learn ${action}: ${error.message}\n`);
    process.exitCode = 1;
  }
}

function readSettings() {
  try {
    return JSON.parse(fs.readFileSync(SETTINGS, 'utf8'));
  } catch (err) {
    // ENOENT is normal. A SyntaxError is the zero-byte or half-written window of
    // somebody else's atomic write — routine rather than exotic, because Claude
    // Code rewrites this file in place on every /model, /effort and approval —
    // and it used to print, because a SyntaxError has no `.code` and so failed
    // the ENOENT test. That broke the hook path's "quiet by design" contract on
    // exactly the interleaving this whole change is about. Anything else is
    // genuinely unexpected and still worth saying out loud.
    if (err.code !== 'ENOENT' && !(err instanceof SyntaxError)) {
      process.stderr.write(`wildcard-perms: read error: ${err.message}\n`);
    }
    return null;
  }
}

// The shared rebasing writer, required lazily so the hook path pays for it only
// when it has actually decided to write. No backup hook: the extension owns the
// high-water mark, and giving the CLI one here would be a behaviour change
// smuggled in beside a correctness fix.
function settingsWriter() {
  const { createSettingsWriter } = require('../src/settings-write');
  return createSettingsWriter({ settingsPath: SETTINGS });
}

// readSettings() collapses "absent" and "unreadable" into null, which is right
// for a reader and destructive for a WRITER: `readSettings() ?? {}` followed by
// a whole-object write replaces the user's settings.json with just the key the
// verb happened to touch. Measured: `--max on` against an unparseable file wrote
// `{"permissions":{...7 blanket entries},"hooks":{"PreToolUse":[...]}}` and
// nothing else, having already recorded an EMPTY allowSnapshot — so `--max off`
// would restore nothing. The CLI writes no high-water backup, so on a CLI-only
// install there was no way back at all.
//
// This is the refusal src/settings-write.js:67-79 documents, reached from the
// two verbs that do not go through writeAllow. The extension's toggleMax
// already got this right; the CLI half was left behind.
function readSettingsForWrite(label) {
  const { readSettingsState, SETTINGS_UNREADABLE } = require('../src/settings-write');
  const state = readSettingsState(SETTINGS);
  if (state.state === SETTINGS_UNREADABLE) {
    process.stderr.write(
      `wildcard-perms ${label}: refused — ${SETTINGS} exists but could not be read or parsed.\n`
      + '  Nothing was changed. That is usually a file being written right now;\n'
      + '  retry in a moment, or fix the file if it is genuinely damaged.\n'
    );
    return null;
  }
  // Absent yields {}, which is the legitimate first-run case.
  return state.settings;
}

// writeSettings is GONE. It was a naive whole-object writer — read, compute,
// spread the snapshot back — and its two callers were `--max` and `--bypass`,
// the last two writers of settings.json in this file that could revert a
// concurrent change. Both now go through settingsWriter().writeTransform, which
// re-reads, runs the transform against that read, and compare-and-swaps on the
// bytes. Deleting the primitive matters as much as fixing the callers: it was
// the thing the next verb author would have found and reused.

function run(input) {
  // Read the bytes ONCE, as a Buffer. The hit path never pays the utf8 decode of
  // a string it would throw away, and on a miss JSON.parse takes the Buffer
  // directly.
  let bytes;
  try { bytes = fs.readFileSync(SETTINGS); }
  catch { return finish(input, false); }   // absent, or unreadable — both silent

  // The cache answers exactly one question: are THESE bytes already known to be
  // a fixed point of processAllowList? A hit skips the parse, the pass, and the
  // whole `../src/permissions` require chain — 13.2 ms of the hook's own work,
  // measured cold, against ~1 ms to key the file.
  //
  // Its own module pulls nothing but fs/path/os, which is why the hash is
  // hand-rolled: `require('crypto')` plus the first createHash plus a digest is
  // 4.15 ms cold in a fresh process (min 3.758 over 21 runs), because the lazy
  // OpenSSL init survives the module snapshot.
  //
  // A hit must still reach finish(). The drain's existsSync gate is independent
  // of the wildcarding fixed point, and skipping it would silently stop
  // promoting project-local approvals.
  const cache = require('../src/fixed-point-cache');
  if (cache.isFixedPoint(bytes)) return finish(input, false);

  // Miss. Only now is the generalizer loaded — that require is 3.5 ms and the
  // cache is the only thing that makes deferring it possible, since the pass was
  // previously unconditional. See the lazy-require discipline at the top of this
  // file.
  const { processAllowList } = require('../src/permissions');

  let settings;
  try { settings = JSON.parse(bytes); }
  catch { return finish(input, false); }   // mid-write; the next run retries
  if (!settings || typeof settings !== 'object') return finish(input, false);

  const before = settings?.permissions?.allow ?? [];
  const after  = processAllowList(before);

  // This read is a NEGATIVE TEST ONLY, which is what makes it safe unlocked. If
  // the list is already a fixed point — the overwhelmingly common case, measured
  // at 404 of 423 entries already generalized here — we exit having written
  // nothing, so a stale read costs nothing. The moment it differs, everything
  // authoritative is redone inside the lock.
  //
  // Deliberately NOT "lock on every call": the lock cycle is 3.7 ms of file
  // operations, and paying it on every tool call to discover there is nothing to
  // do is the same mistake the drain's existsSync test already corrected.
  const pending = JSON.stringify(before) !== JSON.stringify(after);

  // Record the key ONLY for a verified fixed point, and only for the bytes we
  // actually read and checked. Never for bytes we believe we wrote: writeAllow
  // re-reads and rebases inside itself, returns counts rather than the written
  // text, and can fall back to a non-atomic in-place write — so the post-write
  // content is a file state this process never saw. One wasted miss after a
  // write is the correct price, and the cache converges on the next call because
  // what writeAllow leaves behind is itself a fixed point (verified: 0 of 400
  // permutations of the live list are not).
  if (!pending) cache.writeFixedPoint(cache.fixedPointKey(bytes));

  return finish(input, pending);
}

// One exit path for the hook, and now ONE lock acquisition covering both jobs.
//
// The drain runs whether or not the user-scope pass changed anything: Claude
// Code persists an "always approve" into the project's settings.local.json, and
// the hook fires immediately after that write, so this is the moment to promote
// it.
//
// The two jobs used to lock separately — the wildcarding write took no lock at
// all and the drain took its own — leaving a window between them for Auto Learn
// to land its settings write and its claims write. That is verbatim the
// interleaving src/policy-lock.js:3-7 exists to prevent, so they now share one
// acquisition. A busy lock stays silent: the next tool call fires the hook
// again and the pass is idempotent, so losing a turn costs at most one extra
// prompt and never a permission.
// Every caller now `return`s into this rather than relying on it never returning.
// run() went from one tail call to five (read threw, cache hit, parse threw, not
// an object, and the computed pending flag); leaning on process.exit alone across
// five branches is how a cache write ends up running after a finish that did not
// exit.
function finish(input, wildcardPending) {
  const cwd = hookCwd(input);
  const drainPending = !!cwd
    && fs.existsSync(path.join(cwd, '.claude', 'settings.local.json'));
  if (!wildcardPending && !drainPending) process.exit(0);

  const { createPolicyLock, POLICY_LOCK_PATH } = require('../src/policy-lock');
  try {
    createPolicyLock({ lockPath: POLICY_LOCK_PATH }).locked(() => {
      if (wildcardPending) wildcardUnderLock();
      if (drainPending) drainUnderLock(cwd);
    });
  } catch { /* busy, or an unreadable project — the next hook run retries */ }
  process.exit(0);
}

// The hook's event arrives as JSON on stdin; one field matters.
function hookCwd(input) {
  let cwd;
  try { cwd = JSON.parse(String(input || '{}'))?.cwd; }
  catch { return null; }
  return typeof cwd === 'string' && cwd ? cwd : null;
}

// The authoritative half of the pass: the caller's snapshot is DISCARDED and
// everything recomputed from a read taken inside the lock.
//
// Replaying the earlier delta instead would be unsound, and not subtly. With MAX
// on, Claude Code persists `Bash(npm test)`; the unlocked pass marks it removed
// because `Bash(*)` covers it; `--max off` then runs and deliberately preserves
// it; replaying `removed` deletes it for good, since it is absent from
// allowSnapshot precisely because it was granted while MAX was on. Recomputing
// costs the warm 57 ms, and only on the rare changed path.
//
// Because `fresh` is what writeAllow re-reads, its rebase degenerates to
// identity here, and what it contributes is the rest of its contract: deny is
// additive only, and every unrelated top-level field — model, effortLevel, env,
// hooks — comes from the newest file instead of a stale spread. Those fields,
// not deny, are the common casualty: Claude Code rewrites them constantly.
function wildcardUnderLock() {
  const { processAllowList } = require('../src/permissions');
  const writer = settingsWriter();
  const state = writer.readSettingsState();
  const fresh = state.settings;
  if (!fresh) return; // absent or mid-write; the next hook run retries

  const before = Array.isArray(fresh?.permissions?.allow) ? fresh.permissions.allow : [];
  const after = processAllowList(before);
  if (JSON.stringify(before) === JSON.stringify(after)) return; // someone got there first

  try {
    writer.writeAllow(fresh, after);
    const added   = after.filter(p => !before.includes(p));
    const removed = before.filter(p => !after.includes(p));
    process.stderr.write(
      `wildcard-perms: +${added.length} -${removed.length} → ${after.length} entries\n`
    );
  } catch (err) {
    // SETTINGS_UNREADABLE is "come back in a moment", not a failure to shout
    // about — and the hook path is quiet by design either way.
    if (err?.code !== 'SETTINGS_UNREADABLE') {
      process.stderr.write(`wildcard-perms: write error: ${err.message}\n`);
    }
  }
}

function drainUnderLock(cwd) {
  const report = drainWorkspace(cwd);
  if (!report.changed) return;
  process.stderr.write(
    `wildcard-perms: local drain — promoted ${report.promoted.length}, ` +
    `pruned ${report.pruned.length}, kept ${report.kept}\n`
  );
}

// Merge entries into the user-scope allow list, generalizing and pruning the
// result exactly as the hook pass would, so a promoted permission is
// indistinguishable from one approved directly.
function mergeUserAllow(entries) {
  // Through the rebasing writer, and computed from ITS read, so the rebase
  // degenerates to identity. This was the third unrebased read-modify-write in
  // this file, and the one that ran on the hook path immediately after the
  // wildcarding write — so it could revert what the extension had just landed.
  // The extension's half of the drain already routed through writeAllow
  // (vscode-extension/extension.js applyUserAllow); the CLI's was left behind.
  const { processAllowList } = require('../src/permissions');
  const writer = settingsWriter();
  const fresh = writer.readSettingsState().settings ?? {};
  const existing = Array.isArray(fresh?.permissions?.allow) ? fresh.permissions.allow : [];
  const merged = processAllowList([...new Set([...existing, ...entries])]);
  writer.writeAllow(fresh, merged);
}

function drainWorkspace(workspaceRoot, { dryRun = false } = {}) {
  const { drainLocalSettings } = require('../src/local-settings');
  return drainLocalSettings({
    workspaceRoot,
    readUserSettings: readSettings,
    applyUserAllow: mergeUserAllow,
    dryRun,
  });
}

// drainFromHook is gone: its body is now drainUnderLock(), called from finish()
// inside the SAME lock acquisition as the wildcarding write. Keeping its own
// lock meant two acquisitions per changed hook run with a window between them,
// which is exactly what the shared lock is for. The cheap existsSync test it
// introduced survives, in finish().

// Promote a project's local approvals into user scope and drop the ones user
// scope now covers. `--dry-run` reports without writing either file.
function drain(args) {
  let workspaceRoot;
  try {
    workspaceRoot = path.resolve(learnOption(args, '--workspace', process.cwd()));
  } catch (err) {
    process.stderr.write(`wildcard-perms --drain: ${err.message}\n${DRAIN_USAGE}`);
    process.exit(1);
  }
  const dryRun = args.includes('--dry-run');

  withPolicyLock('--drain', () => {
    const report = drainWorkspace(workspaceRoot, { dryRun });

    if (report.error) {
      process.stderr.write(`wildcard-perms --drain: ${report.path}: ${report.error}\n`);
      process.exitCode = 1;
      return;
    }
    if (report.blocked === 'max') {
      process.stderr.write(
        'wildcard-perms --drain: Claude MAX is ON — its blanket Bash(*)/PowerShell(*) layer ' +
        'covers every local entry, so a drain would empty the file and MAX-off would not ' +
        'bring it back. Turn MAX off first.\n'
      );
      process.exitCode = 1;
      return;
    }
    if (!report.exists) {
      process.stdout.write(`wildcard-perms --drain: no project-local approvals at ${report.path}\n`);
      return;
    }
    if (!report.changed) {
      process.stdout.write(
        `wildcard-perms --drain: nothing to do — ${report.kept} local ` +
        `${report.kept === 1 ? 'entry is' : 'entries are'} project-specific\n`
      );
      return;
    }

    const promoted = dryRun ? report.promote : report.promoted;
    const pruned = dryRun ? report.prune : report.pruned;
    process.stdout.write(
      `wildcard-perms --drain${dryRun ? ' (dry run)' : ''}: ` +
      `${dryRun ? 'would promote' : 'promoted'} ${promoted.length} to user scope, ` +
      `${dryRun ? 'would prune' : 'pruned'} ${pruned.length} local ` +
      `${pruned.length === 1 ? 'entry' : 'entries'}, kept ${report.kept}\n`
    );
    if (promoted.length) process.stdout.write(promoted.map((p) => `  + ${p}`).join('\n') + '\n');
    if (!dryRun && !report.verified) {
      process.stderr.write(
        '  note: not every promotion is present in settings.json — managed policy may be ' +
        'filtering it. Nothing was pruned on its account.\n'
      );
    }
    for (const { candidate, rule } of report.denied) {
      process.stdout.write(`  ! ${candidate} not promoted — your deny rule ${rule} outranks it\n`);
    }
    if (report.backup) process.stdout.write(`  snapshot: ${report.backup}\n`);
  });
}

// Install (or remove) the managed shell-style block in ~/.claude/CLAUDE.md. The
// wildcarder can only generalize an approval that names one command, so this is
// the half of the job that has to happen in the agent's instructions.
function guidance(args) {
  const { guidanceStatusAll, setGuidanceAll } = require('../src/agent-guidance');
  const cmd = (args[args.indexOf('--guidance') + 1] || 'status').toLowerCase();

  if (cmd === 'status') {
    const states = guidanceStatusAll();
    if (!states.length) {
      process.stdout.write('wildcard-perms guidance: no agent instruction file found\n');
      return;
    }
    for (const state of states) {
      process.stdout.write(
        `wildcard-perms guidance [${state.agent}]: ${state.on ? 'ON' : 'OFF'}` +
        `${state.on && !state.current ? ' (older wording — run --guidance on to refresh)' : ''} ` +
        `(${state.readable ? state.path : `unreadable: ${state.path}`})\n`
      );
    }
    return;
  }

  // The derived half. Kept behind its own verbs because it is a different kind
  // of thing: `on`/`off` install a fixed paragraph, while these three install
  // advice earned from measured evidence, one item at a time, and nothing is
  // written until a human names the item.
  if (cmd === 'derived' || cmd === 'accept' || cmd === 'decline' || cmd === 'reset') {
    const { createAutoLearnManager } = require('../src/auto-learn-manager');
    try {
      // `--workspace` is not cosmetic here: the learner's state is partitioned
      // per workspace, so defaulting to cwd reads a DIFFERENT state file and
      // reports an empty review on a machine that has plenty to show.
      const manager = createAutoLearnManager({
        workspaceRoot: path.resolve(learnOption(args, '--workspace', process.cwd())),
      });
      if (cmd === 'derived') {
        process.stdout.write(JSON.stringify(manager.derivedReview(), null, 2) + '\n');
        return;
      }
      // Positionally, but skipping flag/value pairs. Taking `+ 2` blindly meant
      // `--guidance accept --workspace D:\x batch-file-edits` recorded a
      // decision for the id `--workspace`, which passes the id pattern, and
      // then ran a full reconcile against it.
      const id = positionalAfter(args, '--guidance', 2);
      if (!id) {
        process.stderr.write(`wildcard-perms --guidance ${cmd}: an id is required. ` +
          'Run --guidance derived to list them.\n');
        process.exit(1);
      }
      const outcome = manager.decideDerived(id, cmd);
      process.stdout.write(JSON.stringify(outcome, null, 2) + '\n');
      // A failed write to someone's instruction file must not exit 0. The
      // on/off path below already checks this; these verbs did not.
      const failed = (outcome.targets || []).filter((target) => target.error);
      if (failed.length) {
        for (const target of failed) {
          process.stderr.write(`wildcard-perms --guidance ${cmd} [${target.agent}]: ${target.error}\n`);
        }
        process.exitCode = 1;
      } else if (outcome.blocked) {
        process.stderr.write(`wildcard-perms --guidance ${cmd}: decision recorded, but the ` +
          `instruction file was left alone (${outcome.blocked}).\n`);
        process.exitCode = 1;
      }
    } catch (error) {
      process.stderr.write(`wildcard-perms --guidance ${cmd}: ${error.message}\n`);
      process.exitCode = 1;
    }
    return;
  }

  if (cmd !== 'on' && cmd !== 'off') {
    process.stderr.write(GUIDANCE_USAGE);
    process.exit(1);
  }

  const results = setGuidanceAll(cmd === 'on');
  if (!results.length) {
    process.stderr.write('wildcard-perms --guidance: no agent instruction file to write\n');
    process.exit(1);
  }
  for (const result of results) {
    if (result.error) {
      process.stderr.write(`wildcard-perms --guidance [${result.agent}]: ${result.error}\n`);
      process.exitCode = 1;
      continue;
    }
    process.stdout.write(
      `wildcard-perms guidance [${result.agent}]: ${cmd.toUpperCase()}` +
      `${result.changed ? '' : ' (already)'} — ${result.path}\n`
    );
  }
  if (cmd === 'on' && results.some((result) => result.changed)) {
    process.stdout.write('  loaded in every session of every project from the next session on.\n');
  }
}

// The compiled memory gates. Same install plumbing as --guidance, separate markers and
// separate switch: one is this repo's wording, the other is whatever recall.py last
// compiled out of the memory corpus, so neither may turn the other off.
function gates(args) {
  const { spawnSync } = require('child_process');
  const { gatesStatusAll, setGatesAll } = require('../src/agent-gates');
  const cmd = (args[args.indexOf('--gates') + 1] || 'status').toLowerCase();

  if (cmd === 'status') {
    const states = gatesStatusAll();
    if (!states.length) {
      process.stdout.write('wildcard-perms gates: no agent instruction file found\n');
      return;
    }
    for (const state of states) {
      process.stdout.write(
        `wildcard-perms gates [${state.agent}]: ${state.on ? 'ON' : 'OFF'}` +
        `${state.on && !state.current ? ' (corpus changed — run --gates on to refresh)' : ''}` +
        `${state.compiled ? '' : ' (nothing compiled)'} ` +
        `(${state.readable ? state.path : `unreadable: ${state.path}`})\n`
      );
    }
    return;
  }

  // `refresh` = compile then install, which is what a SessionStart hook wants: edit a gate
  // in a memory file and the next session is correct with no remembered step. recall.py
  // re-execs itself into the toolbox venv, so a bare `python` is enough here.
  if (cmd === 'refresh') {
    const recall = path.join(__dirname, '..', 'memory', 'recall.py');
    const compile = spawnSync(process.env.TOOLBOX_PYTHON || 'python', [recall, '--gates-compile'],
      { encoding: 'utf8' });
    if (compile.error || compile.status !== 0) {
      // Non-fatal by design: a hook that fails loudly on every session start is worse than
      // a slightly stale block, and --gates status still reports the staleness.
      process.stderr.write('wildcard-perms --gates refresh: compile failed, '
        + `installing whatever was last compiled (${compile.error?.message
          || (compile.stderr || '').trim() || `exit ${compile.status}`})\n`);
    }
  }

  if (cmd !== 'on' && cmd !== 'off' && cmd !== 'refresh') {
    process.stderr.write(GATES_USAGE);
    process.exit(1);
  }

  const results = setGatesAll(cmd !== 'off');
  if (!results.length) {
    process.stderr.write('wildcard-perms --gates: no agent instruction file to write\n');
    process.exit(1);
  }
  for (const result of results) {
    if (result.error) {
      process.stderr.write(`wildcard-perms --gates [${result.agent}]: ${result.error}\n`);
      process.exitCode = 1;
      continue;
    }
    // `refresh` is the SessionStart hook, and a hook's stdout can be folded into the
    // session's context. Stay silent when nothing changed, so the common case costs no
    // tokens and a line appearing actually means something moved.
    if (cmd === 'refresh' && !result.changed) continue;
    process.stdout.write(
      `wildcard-perms gates [${result.agent}]: ${cmd.toUpperCase()}` +
      `${result.changed ? '' : ' (already)'} — ${result.path}\n`
    );
  }
  if (cmd !== 'off' && results.some((result) => result.changed)) {
    process.stdout.write('  standing orders resident from the next session on.'
      + (cmd === 'on' ? ' Re-run after editing a gate in a memory file.\n' : '\n'));
  }
}

function seed() {
  let pack;
  try {
    pack = JSON.parse(fs.readFileSync(PACK_PATH, 'utf8'));
  } catch (err) {
    process.stderr.write(`wildcard-perms --seed: cannot read starter pack: ${err.message}\n`);
    process.exit(1);
  }

  // Read, merge and write all INSIDE the lock, through the rebasing writer.
  // --seed had the same shape as the old hook path — read, merge, spread, write
  // — so it reverted whatever landed in between, and it took no lock at all
  // while `withPolicyLock` sat twenty lines below serving --drain/--bypass/--max.
  //
  // Reporting happens after the lock is released, and nothing inside it calls
  // process.exit: an exit skips the release, and while recoverLock() reclaims a
  // dead owner's lock eventually, leaving one behind makes every other writer
  // wait for the staleness window first.
  let outcome = null;
  withPolicyLock('--seed', () => {
    const { processAllowList } = require('../src/permissions');
    const writer = settingsWriter();
    const settings = writer.readSettingsState().settings ?? {};
    const existing = Array.isArray(settings?.permissions?.allow) ? settings.permissions.allow : [];

    // Merge: existing entries first (preserve ordering), then new pack entries
    const merged = [...new Set([...existing, ...pack])];
    const after  = processAllowList(merged);

    if (JSON.stringify(existing) === JSON.stringify(after)) {
      outcome = { noop: true };
      return;
    }
    writer.writeAllow(settings, after);
    outcome = {
      after,
      added: after.filter(p => !existing.includes(p)),
      removed: existing.filter(p => !after.includes(p)),
    };
  });

  if (!outcome) return; // withPolicyLock already reported and exited
  if (outcome.noop) {
    process.stdout.write('wildcard-perms --seed: allow list already covers starter pack — nothing to do\n');
    return;
  }
  process.stdout.write(
    `wildcard-perms --seed: merged ${pack.length} starter entries — ` +
    `+${outcome.added.length} added, ${outcome.removed.length} pruned → ${outcome.after.length} total\n`
  );
  if (outcome.added.length) {
    process.stdout.write(outcome.added.map(p => `  + ${p}`).join('\n') + '\n');
  }
}

// Every policy writer shares one lock, so a toggle cannot land between Auto
// Learn's settings write and its claims write. Read and write both go inside:
// MAX-off unions the sidecar snapshot with what was granted since, so a write
// landing between the read and the write would be re-pruned back out.
function withPolicyLock(flag, run) {
  const {
    createPolicyLock, POLICY_LOCK_PATH, POLICY_LOCK_CODE, POLICY_LOCK_BUSY_MESSAGE,
  } = require('../src/policy-lock');
  try {
    createPolicyLock({ lockPath: POLICY_LOCK_PATH }).locked(run);
  } catch (err) {
    process.stderr.write(err?.code === POLICY_LOCK_CODE
      ? `wildcard-perms ${flag}: ${POLICY_LOCK_BUSY_MESSAGE}\n`
      : `wildcard-perms ${flag}: write error: ${err.message}\n`);
    process.exit(1);
  }
}

// Flip Claude Code's bypassPermissions mode on/off (our "skip every prompt"
// switch). `--bypass on|off|status`; bare `--bypass` reports status. Turning on
// stashes the previous mode so `off` restores it. Deny rules + Claude Code's
// hard circuit breakers still apply — this suppresses prompts, not safeguards.
function bypass(args) {
  const { applyBypass, isBypassOn, currentMode } = require('../src/permissions');
  const cmd = (args[args.indexOf('--bypass') + 1] || 'status').toLowerCase();

  if (cmd === 'status') {
    const settings = readSettings() ?? {};
    process.stdout.write(
      `wildcard-perms bypass: ${isBypassOn(settings) ? 'ON' : 'OFF'} (defaultMode=${currentMode(settings)})\n`
    );
    return;
  }

  if (cmd !== 'on' && cmd !== 'off') {
    process.stderr.write('usage: wildcard-perms --bypass on|off|status\n');
    process.exit(1);
  }

  withPolicyLock('--bypass', () => {
    // Kept ahead of the writer even though writeTransform refuses an unreadable
    // file too: this path owns the word "refused", which test/cli-hook.test.js
    // pins, while the writer's throw would surface as "write error:" through
    // withPolicyLock's catch.
    if (readSettingsForWrite('--bypass') === null) { process.exitCode = 1; return; }
    let res;
    try {
      // The transform runs against the writer's OWN fresh read, so
      // permissions.defaultMode is set on the newest file rather than on a
      // snapshot taken before the lock work. applyBypass touches nothing else.
      ({ result: res } = settingsWriter().writeTransform((latest) => applyBypass(latest, cmd === 'on')));
    } catch (err) {
      process.stderr.write(`wildcard-perms --bypass: refused — ${err.message}\n`);
      process.exitCode = 1;
      return;
    }
    if (!res.changed) {
      process.stdout.write(`wildcard-perms bypass: already ${cmd.toUpperCase()} (defaultMode=${res.to})\n`);
      return;
    }
    process.stdout.write(
      `wildcard-perms bypass: ${res.from} → ${res.to} — ` +
      `${cmd === 'on' ? 'ALL PROMPTS BYPASSED' : 'prompts restored'}. ` +
      `Reload the Claude Code window (or wait for context rollover) to apply.\n`
    );
    if (cmd === 'on') {
      process.stdout.write('  deny rules and hard circuit breakers still apply.\n');
    }
  });
}

// Codex MAX — the Codex-side counterpart of `--max`. Sets approval_policy in
// ~/.codex/config.toml and deliberately leaves sandbox_mode alone, so prompts
// stop but the sandbox stays as the floor (Codex has no deny list to fall back
// on). It aims for "never" but obeys an enterprise requirements bundle that
// restricts which policies are legal. `--codex-max on|off|status`.
//
// No policy lock here: this writes Codex's config.toml, not Claude's
// settings.json, so it shares no file with Auto Learn or the wildcarding pass.
function codexMax(args) {
  const { writeFileAtomicSync } = require('../src/permissions');
  const {
    CODEX_CONFIG, applyCodexMax, isCodexMaxOn, readApproval, sandboxMode,
    readEnterpriseBundle, targetApproval,
  } = require('../src/codex-max');
  const cmd = (args[args.indexOf('--codex-max') + 1] || 'status').toLowerCase();
  const text = fs.existsSync(CODEX_CONFIG) ? fs.readFileSync(CODEX_CONFIG, 'utf8') : null;
  const target = targetApproval(readEnterpriseBundle());

  if (cmd === 'status') {
    if (text === null) {
      process.stdout.write(`wildcard-perms Codex MAX: no config at ${CODEX_CONFIG}\n`);
      return;
    }
    process.stdout.write(
      `wildcard-perms Codex MAX: ${isCodexMaxOn(text) ? 'ON' : 'OFF'} ` +
      `(approval_policy=${readApproval(text) ?? 'unset'}, sandbox_mode=${sandboxMode(text) ?? 'unset'})\n`
    );
    if (target.restricted) {
      process.stdout.write(
        `  enterprise policy allows only [${(target.allowed || []).join(', ')}] — ` +
        `'never' is not permitted, so the best available is ${target.value ?? 'nothing'}.\n`
      );
    }
    return;
  }

  if (cmd !== 'on' && cmd !== 'off') {
    process.stderr.write('usage: wildcard-perms --codex-max on|off|status\n');
    process.exit(1);
  }

  const res = applyCodexMax(text ?? '', cmd === 'on');
  // Same reasoning as --max: the snapshot is the only record of the user's prior
  // approval_policy, so without it, turning Codex MAX off would delete the key
  // rather than restore the value. Refuse and say so.
  if (res.error === 'codex-max-snapshot-failed') {
    process.stderr.write(
      'wildcard-perms --codex-max: refused — could not write the approval snapshot to\n'
      + '  ~/.claude/backups, so turning Codex MAX off later would remove approval_policy\n'
      + '  instead of restoring yours. config.toml is unchanged.\n'
    );
    process.exitCode = 1;
    return;
  }
  if (res.blockedBy === 'enterprise-policy') {
    process.stderr.write(
      'wildcard-perms --codex-max: enterprise policy permits no approval policy this can set ' +
      `(allowed: ${(res.allowed || []).join(', ') || 'none'}).\n`
    );
    process.exit(1);
  }
  if (!res.changed) {
    process.stdout.write(`wildcard-perms Codex MAX: already ${cmd.toUpperCase()}\n`);
    return;
  }

  try {
    fs.mkdirSync(path.dirname(CODEX_CONFIG), { recursive: true });
    writeFileAtomicSync(CODEX_CONFIG, res.text);
    const sandbox = sandboxMode(res.text) ?? 'unset';
    process.stdout.write(
      `wildcard-perms Codex MAX: ${cmd.toUpperCase()} — ` +
      `${cmd === 'on'
        ? `approval_policy=${res.target}${res.restricted ? " (enterprise policy forbids 'never')" : ''} (sandbox_mode=${sandbox}, untouched)`
        : `approval_policy=${res.restoredTo ?? 'unset (key removed)'}`}. ` +
      'Restart Codex to apply.\n'
    );
    if (cmd === 'on') {
      process.stdout.write(
        `  the ${sandbox} sandbox is still the floor: out-of-workspace writes and network remain blocked.\n`
      );
    }
  } catch (err) {
    process.stderr.write(`wildcard-perms --codex-max: write error: ${err.message}\n`);
    process.exit(1);
  }
}

// Flip MAX mode — the two-layer "skip everything" switch (blanket allow-list
// wildcards + a PreToolUse auto-approve hook), independent of Claude Code's
// bypassPermissions mode. `--max on|off|status`; bare `--max` reports status.
function max(args) {
  const { applyMax, isMaxOn, maxLayers } = require('../src/permissions');
  const cmd = (args[args.indexOf('--max') + 1] || 'status').toLowerCase();

  if (cmd === 'status') {
    const settings = readSettings() ?? {};
    const L = maxLayers(settings);
    process.stdout.write(
      `wildcard-perms MAX: ${isMaxOn(settings) ? 'ON' : 'OFF'} ` +
      `(allow-wildcards=${L.allow ? 'on' : 'off'}, approve-hook=${L.hook ? 'on' : 'off'})\n`
    );
    return;
  }

  if (cmd !== 'on' && cmd !== 'off') {
    process.stderr.write('usage: wildcard-perms --max on|off|status\n');
    process.exit(1);
  }

  withPolicyLock('--max', () => {
    // Before applyMax, which writes the allow-list snapshot as a side effect —
    // an unreadable read here would have recorded an EMPTY snapshot over a real
    // one, making `--max off` unable to restore anything. writeTransform refuses
    // that case too, and refuses BEFORE running the transform for the same
    // reason; this check stays because it owns the "refused" wording the tests
    // pin, and because the file can become unreadable between the two reads.
    if (readSettingsForWrite('--max') === null) { process.exitCode = 1; return; }
    let res;
    let wrote = false;
    try {
      // applyMax IS the transform, not a value computed before the write. Its
      // side effects — the allow-list snapshot and the approve script — are
      // therefore taken against the same read the write lands on, which is what
      // makes the snapshot reflect the freshest list rather than one from before
      // the ~9.6 ms pass. An approval that lands in that window is now restored
      // by `--max off` instead of being lost.
      ({ result: res, wrote } = settingsWriter().writeTransform((latest) => applyMax(latest, cmd === 'on')));
    } catch (err) {
      process.stderr.write(`wildcard-perms --max: refused — ${err.message}\n`);
      process.exitCode = 1;
      return;
    }
    // A refusal is not "already in that state". Reporting "already ON" after the
    // allow snapshot failed to land would be the worst possible answer: MAX is
    // off, the user believes it is on, and the snapshot that alone could restore
    // their allow list does not exist.
    if (res.error === 'max-snapshot-failed') {
      process.stderr.write(
        'wildcard-perms --max: refused — could not write the allow-list snapshot to\n'
        + '  ~/.claude/backups, so turning MAX off later could not restore your entries.\n'
        + '  MAX is unchanged. Check that directory is writable and retry.\n'
      );
      process.exitCode = 1;
      return;
    }
    if (!res.changed) {
      process.stdout.write(`wildcard-perms MAX: already ${cmd.toUpperCase()}\n`);
      return;
    }
    const L = maxLayers(res.settings);
    process.stdout.write(
      `wildcard-perms MAX: ${cmd.toUpperCase()} — ` +
      `${cmd === 'on' ? 'ALL PROMPTS SKIPPED' : 'restored your allow list (keeping anything approved since) + removed approve hook'} ` +
      `(allow-wildcards=${L.allow ? 'on' : 'off'}, approve-hook=${L.hook ? 'on' : 'off'}). ` +
      `Reload the Claude Code window to apply.\n`
    );
    if (cmd === 'on') {
      process.stdout.write('  deny rules and hard circuit breakers still apply.\n');
    }
    if (res.switchedMode) {
      process.stdout.write(
        `  permission mode switched from ${res.switchedMode} to default: auto mode discards Bash(*) as\n` +
        '  classifier-bypassing, so MAX would have granted nothing there. --max off puts the mode back.\n'
      );
    }
    if (res.restoredMode) {
      process.stdout.write(`  permission mode restored to ${res.restoredMode}.\n`);
    }
  });
}
